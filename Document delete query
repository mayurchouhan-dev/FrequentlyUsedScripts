delete from Documents where leveltypecode = 'OBSERVATION' and  levelid not in (select id from  safetyobservations)
 
DELETE d
FROM Documents d
WHERE d.LevelTypeCode = 'OBSERVATIONCHECKLIST'
  AND NOT EXISTS (SELECT 1 FROM SafetyObservationChecklists s WHERE s.Id = d.LevelId)
  AND NOT EXISTS (SELECT 1 FROM SafetyObservationChecklists s WHERE s.DocumentId = d.Id);
 
 
