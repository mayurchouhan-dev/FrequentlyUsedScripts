/* Normalised keys: lower-case, trimmed, repeated spaces collapsed */
ALTER TABLE #Src ADD NameKey NVARCHAR(400), ValueKey NVARCHAR(400);
UPDATE #Src
SET NameKey  = LOWER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(TyreSpecName, '  ', ' '), '  ', ' '), '  ', ' ')))),
    ValueKey = LOWER(LTRIM(RTRIM(OptionValue)));



/* ---------- CHECK 0: is the classification property the same on STAGE? ---------- */
SELECT COUNT(*) AS ClassificationOptionsOnStage
FROM GlobalPropertyOptions
WHERE PropertyId = @ClassificationPropertyId;   -- 0 means the PropertyId differs on STAGE; change the variable



/* Lookups on STAGE: one row per name / value */
IF OBJECT_ID('tempdb..#Spec') IS NOT NULL DROP TABLE #Spec;
SELECT Id, NameKey
INTO #Spec
FROM (
    SELECT Id,
           LOWER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(Name, '  ', ' '), '  ', ' '), '  ', ' ')))) AS NameKey,
           ROW_NUMBER() OVER (PARTITION BY LOWER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(Name, '  ', ' '), '  ', ' '), '  ', ' '))))
                              ORDER BY ISNULL(IsDeleted, 0),
                                       CASE WHEN CompanyId IS NULL THEN 0 ELSE 1 END,
                                       CreatedOnUtc) AS rn
    FROM TyreSpecifications
) x
WHERE rn = 1;



IF OBJECT_ID('tempdb..#Opt') IS NOT NULL DROP TABLE #Opt;
SELECT Id, ValueKey
INTO #Opt
FROM (
    SELECT Id,
           LOWER(LTRIM(RTRIM(OptionValue))) AS ValueKey,
           ROW_NUMBER() OVER (PARTITION BY LOWER(LTRIM(RTRIM(OptionValue))) ORDER BY CreatedOnUtc) AS rn
    FROM GlobalPropertyOptions
    WHERE PropertyId = @ClassificationPropertyId
) x
WHERE rn = 1;



/* ---------- CHECK 1: tyre spec names not found on STAGE (these rows are skipped) ---------- */
SELECT DISTINCT s.TyreSpecName AS MissingTyreSpecOnStage
FROM #Src s
LEFT JOIN #Spec sp ON sp.NameKey = s.NameKey
WHERE sp.Id IS NULL
ORDER BY 1;



/* ---------- CHECK 2: classification options not found on STAGE (these rows are skipped) ---------- */
SELECT DISTINCT s.OptionValue AS MissingOptionOnStage
FROM #Src s
LEFT JOIN #Opt o ON o.ValueKey = s.ValueKey
WHERE o.Id IS NULL
ORDER BY 1;



/* ---------- CHECK 3: spec names that exist more than once on STAGE ---------- */
SELECT LOWER(LTRIM(RTRIM(t.Name))) AS DuplicateNameOnStage, COUNT(*) AS Copies
FROM TyreSpecifications t
WHERE LOWER(LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(t.Name, '  ', ' '), '  ', ' '), '  ', ' ')))) IN (SELECT NameKey FROM #Src)
GROUP BY LOWER(LTRIM(RTRIM(t.Name)))
HAVING COUNT(*) > 1;



