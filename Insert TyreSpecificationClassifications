BEGIN TRANSACTION;



INSERT INTO TyreSpecificationClassifications (Id, TyreSpecificationId, ClassificationId, ClassificationName)
SELECT NEWID(), sp.Id, o.Id, s.ClassificationName
FROM #Src s
JOIN #Spec sp ON sp.NameKey = s.NameKey
JOIN #Opt  o  ON o.ValueKey = s.ValueKey
WHERE NOT EXISTS (
    SELECT 1 FROM TyreSpecificationClassifications x
    WHERE x.TyreSpecificationId = sp.Id
      AND x.ClassificationId    = o.Id
);



SELECT @@ROWCOUNT AS InsertedRows,
       (SELECT COUNT(*) FROM #Src) AS SourceRows;



/* Preview */
SELECT ts.Name AS TyreSpec, gpo.OptionValue AS Classification, tsc.ClassificationName, tsc.Id
FROM TyreSpecificationClassifications tsc
JOIN TyreSpecifications    ts  ON ts.Id  = tsc.TyreSpecificationId
JOIN GlobalPropertyOptions gpo ON gpo.Id = tsc.ClassificationId
JOIN #Spec sp ON sp.Id = ts.Id
JOIN #Src  s  ON s.NameKey = sp.NameKey AND s.ValueKey = LOWER(LTRIM(RTRIM(gpo.OptionValue)))
ORDER BY ts.Name, gpo.OptionValue;



