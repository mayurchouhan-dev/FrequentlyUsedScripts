DECLARE @TenantId uniqueidentifier = '839240CE-A87C-48CA-AA30-D1A68D98EDF4';

/* ===== 2. Preview ===== */
SELECT s.InspectionNumber, s.TyreSerialNumber,
       i.Id AS InspectionId, itp.Id AS ItpId,
       s.OldTyreHours, itp.TyreHours,
       itp.ScrapReasonNotes AS CurrentNotes, s.OldNotes,
       CASE WHEN i.Id IS NULL   THEN 'Inspection missing'
            WHEN itp.Id IS NULL THEN 'Tyre row missing'
            ELSE 'OK' END AS Status
FROM #src s
LEFT JOIN Inspections i
       ON i.InspectionNumber = s.InspectionNumber
      AND i.TenantId = @TenantId
LEFT JOIN InspectionTyrePositionSpecificDatas itp
       ON itp.InspectionId = i.Id
      AND itp.TyreSerialNumber = s.TyreSerialNumber
      AND itp.TyreHours = s.OldTyreHours
ORDER BY Status DESC, s.InspectionNumber;

/* ===== 3. Backup of the rows that will change ===== */
IF OBJECT_ID('tempdb..#backup') IS NOT NULL DROP TABLE #backup;

SELECT itp.Id, itp.ScrapReasonNotes
INTO #backup
FROM InspectionTyrePositionSpecificDatas itp
JOIN Inspections i ON i.Id = itp.InspectionId
JOIN #src s
     ON s.InspectionNumber = i.InspectionNumber
    AND s.TyreSerialNumber = itp.TyreSerialNumber
    AND s.OldTyreHours     = itp.TyreHours
WHERE i.TenantId = @TenantId;

