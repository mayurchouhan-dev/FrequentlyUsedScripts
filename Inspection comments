SELECT ti.InspectionNumber,
       tti.TyreSerialNumber,
       tti.CreationDate,
       tti.TyreHours,
       tti.Kilometers,
       tti.Notes
FROM Tbl_Inspection ti
INNER JOIN Tbl_Inspection_TyrePositionSpecific_Data tti
    ON ti.uid = tti.InspectionId
WHERE ti.CompanyId = 1169
  AND ti.AssetTypeId IN (2, 3)
  AND tti.Notes <> ''
ORDER BY ti.CreationDate DESC, tti.TyreSerialNumber;



