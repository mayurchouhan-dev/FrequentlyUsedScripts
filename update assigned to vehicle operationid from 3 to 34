DECLARE @CompanyId INT = 1169;



DECLARE @Counts TABLE (AssetType VARCHAR(30), UpdatedRows INT);



BEGIN TRANSACTION;



-- Tyres
UPDATE tto
SET tto.OperationTypeId = 34
FROM Tbl_Tyre_Operations tto
INNER JOIN Tbl_Tyre_Asset ta
    ON tto.AssetId = ta.uid
WHERE ta.CompanyId = @CompanyId
  AND tto.OperationTypeId = 3
  AND (
        tto.Details LIKE '%Disposition changed to In Production%'
        OR tto.Details LIKE '%Tyre assigned to truck%'
      );
INSERT INTO @Counts VALUES ('Tyres', @@ROWCOUNT);



