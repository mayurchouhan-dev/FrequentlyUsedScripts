select
--od.uid,
od.ObservationNumber, ts.SiteName, od.other_offsider, od.other_operator 
--*
from Tbl_ObservationDetail  od
inner join Tbl_Site ts on od.SiteId = ts.Uid
where (od.IsDeleted is null or od.IsDeleted = 0) and
od.CompanyId=1159 and od.Fitteroffsider > 0 and od.Fitteroperator = 0
--and od.other_offsider is not null
and od.other_operator is not null
order by ts.SiteName
 
