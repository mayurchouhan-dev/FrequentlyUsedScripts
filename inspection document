SELECT COUNT(*) AS SourceRows FROM #doc;   -- expect 33

/* B1. Preview */
SELECT s.InspectionId, s.FileName,
       CASE WHEN EXISTS (SELECT 1 FROM Documents d
                         WHERE TRY_CAST(d.LevelId AS uniqueidentifier) = TRY_CAST(s.InspectionId AS uniqueidentifier)
                           AND d.Name = s.FileName)
            THEN 'Already exists (skipped)' ELSE 'OK' END AS Status
FROM #doc s
ORDER BY Status DESC, s.InspectionId;

/* B2. Insert */
BEGIN TRAN;

INSERT INTO Documents
    (Id, DocumentPath, Name, Size, DocTypeCode, LevelId, LevelTypeCode,
     CreatedBy, CreatedOnUtc, ModifiedBy, ModifiedOnUtc)
SELECT NEWID(),
       'https://mtv3storage.blob.core.windows.net/tmass-documents/migration/' + s.FileName,
       s.FileName,
       NULL,
       NULL,
       s.InspectionId,
       'INSPECTION',
       s.CreatedBy, s.CreatedOnUtc, s.ModifiedBy, s.ModifiedOnUtc
FROM #doc s
WHERE NOT EXISTS (SELECT 1 FROM Documents d
                  WHERE TRY_CAST(d.LevelId AS uniqueidentifier) = TRY_CAST(s.InspectionId AS uniqueidentifier)
                    AND d.Name = s.FileName);

SELECT @@ROWCOUNT AS RowsInserted;   -- should equal the 'OK' count in B1 (max 33)

/* B3. Verify */
SELECT d.Id, d.Name, d.DocumentPath, d.LevelId, d.LevelTypeCode, d.CreatedBy, d.CreatedOnUtc
FROM Documents d
JOIN #doc s
  ON TRY_CAST(d.LevelId AS uniqueidentifier) = TRY_CAST(s.InspectionId AS uniqueidentifier)
 AND d.Name = s.FileName
ORDER BY d.LevelId, d.Name;

