DECLARE @TenantId uniqueidentifier = '839240CE-A87C-48CA-AA30-D1A68D98EDF4';

/* A1. Inspection numbers NOT found exactly once (no rows = all good) */
SELECT g.InspectionNumber, COUNT(DISTINCT i.Id) AS MatchesInNewDb
FROM (SELECT DISTINCT InspectionNumber FROM #img) g
LEFT JOIN Inspections i
       ON i.InspectionNumber = g.InspectionNumber
      AND i.TenantId = @TenantId
GROUP BY g.InspectionNumber
HAVING COUNT(DISTINCT i.Id) <> 1;

/* A2. Rows for Part B (copy the whole output column) */
SELECT '(N''' + CAST(i.Id AS nvarchar(36)) + ''',N'''
     + RIGHT(g.ImageURL, CHARINDEX('/', REVERSE(g.ImageURL)) - 1) + ''','
     + CASE WHEN i.CreatedBy     IS NULL THEN 'NULL' ELSE 'N''' + REPLACE(CAST(i.CreatedBy  AS nvarchar(200)), '''', '''''') + '''' END + ','
     + CASE WHEN i.CreatedOnUtc  IS NULL THEN 'NULL' ELSE '''' + CONVERT(varchar(33), i.CreatedOnUtc, 126) + '''' END + ','
     + CASE WHEN i.ModifiedBy    IS NULL THEN 'NULL' ELSE 'N''' + REPLACE(CAST(i.ModifiedBy AS nvarchar(200)), '''', '''''') + '''' END + ','
     + CASE WHEN i.ModifiedOnUtc IS NULL THEN 'NULL' ELSE '''' + CONVERT(varchar(33), i.ModifiedOnUtc, 126) + '''' END
     + '),' AS RowForPartB
FROM #img g
JOIN Inspections i
     ON i.InspectionNumber = g.InspectionNumber
    AND i.TenantId = @TenantId
ORDER BY g.InspectionNumber;

