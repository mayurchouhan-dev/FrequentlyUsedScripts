BEGIN TRANSACTION;



INSERT INTO VehicleSpecificationRecommendedTyres
       (Id, VehicleSpecificationId, WidthRatio, Diameter, CreatedBy, CreatedOnUtc, ModifiedBy, ModifiedOnUtc)
SELECT NEWID(), vs.Id, r.WidthRatio, r.Diameter, @CreatedBy, SYSUTCDATETIME(), NULL, NULL
FROM #Rec r
JOIN VehicleSpecifications vs
  ON ISNULL(vs.IsDeleted, 0) = 0
AND LTRIM(RTRIM(REPLACE(REPLACE(vs.Name, '  ', ' '), '  ', ' '))) = r.Name
WHERE NOT EXISTS (
    SELECT 1 FROM VehicleSpecificationRecommendedTyres x
    WHERE x.VehicleSpecificationId = vs.Id
      AND LTRIM(RTRIM(CAST(x.WidthRatio AS NVARCHAR(50)))) = r.WidthRatio
      AND LTRIM(RTRIM(CAST(x.Diameter   AS NVARCHAR(50)))) = r.Diameter
);



SELECT @@ROWCOUNT AS InsertedRows;



/* Preview what was inserted in this run */
SELECT vs.Name, t.WidthRatio, t.Diameter, t.Id
FROM VehicleSpecificationRecommendedTyres t
JOIN VehicleSpecifications vs ON vs.Id = t.VehicleSpecificationId
WHERE t.CreatedBy = @CreatedBy
  AND t.CreatedOnUtc >= DATEADD(MINUTE, -5, SYSUTCDATETIME())
ORDER BY vs.Name, t.WidthRatio;



