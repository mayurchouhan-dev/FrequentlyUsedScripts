/* Normalise: trim and collapse repeated spaces in names */
UPDATE #Rec
SET Name       = LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(Name, '  ', ' '), '  ', ' '), '  ', ' '))),
    WidthRatio = LTRIM(RTRIM(WidthRatio)),
    Diameter   = LTRIM(RTRIM(Diameter));



/* Remove exact duplicates within the list itself */
;WITH d AS (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY Name, WidthRatio, Diameter ORDER BY (SELECT 0)) AS rn
    FROM #Rec
)
DELETE FROM d WHERE rn > 1;



/* ---------- CHECK 1: names with no matching VehicleSpecification ---------- */
SELECT DISTINCT r.Name AS UnmatchedName
FROM #Rec r
WHERE NOT EXISTS (
    SELECT 1 FROM VehicleSpecifications vs
    WHERE ISNULL(vs.IsDeleted, 0) = 0
      AND LTRIM(RTRIM(REPLACE(REPLACE(vs.Name, '  ', ' '), '  ', ' '))) = r.Name
)
ORDER BY r.Name;



/* ---------- CHECK 2: names that match MORE than one VehicleSpecification ---------- */
SELECT LTRIM(RTRIM(REPLACE(REPLACE(vs.Name, '  ', ' '), '  ', ' '))) AS Name,
       COUNT(*) AS SpecCount,
       STRING_AGG(CAST(vs.Id AS NVARCHAR(36)) + ISNULL(' (company ' + CAST(vs.CompanyId AS NVARCHAR(36)) + ')', ' (global)'), ', ') AS SpecIds
FROM VehicleSpecifications vs
WHERE ISNULL(vs.IsDeleted, 0) = 0
