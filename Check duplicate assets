SELECT
    LTRIM(RTRIM(SerialNumber))                   AS SerialNumber,
    COUNT(*)                                     AS DuplicateCount,
    STRING_AGG(CAST(Id AS NVARCHAR(50)), ', ')
        WITHIN GROUP (ORDER BY Id)               AS DuplicateIds
FROM TyreAssets
WHERE TenantId = 'ACCF0084-2EDE-4E78-9383-965977FBB10A'
--  AND SiteId   = '24B53DF7-1F96-4236-BACA-01A78F5FB577'
GROUP BY LTRIM(RTRIM(SerialNumber))
HAVING COUNT(*) > 1
ORDER BY DuplicateCount DESC, SerialNumber;


